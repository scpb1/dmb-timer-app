# Скопируй в .bot-deploy.env в корне репозитория (файл в .gitignore)

BOT_DEPLOY_HOST=123.45.67.89
BOT_DEPLOY_USER=deploy
BOT_SSH_PORT=22

# Папка бота на сервере (должна совпадать с WorkingDirectory в systemd)
BOT_DEPLOY_PATH=/home/deploy/girly-ddd-bot

# Режим git: каталог клона монорепозитория
BOT_REPO_DIR=/home/deploy/dmb-timer-app
BOT_GIT_URL=https://github.com/scpb1/dmb-timer-app.git
BOT_GIT_BRANCH=main

# Имя user systemd-сервиса
BOT_SYSTEMD_UNIT=girly-ddd-bot