{
  "expo": {
    "name": "Жди",
    "slug": "zhdi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zhdi.app",
      "deploymentTarget": "15.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0a0a0b"
      },
      "package": "com.zhdi.app",
      "minSdkVersion": 26
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ],
      "expo-local-authentication",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото для фона таймера, дневника и записей встреч.",
          "cameraPermission": "Приложению нужен доступ к камере для фото и видео встреч.",
          "microphonePermission": "Приложению нужен доступ к микрофону для записи видео."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
