{
  "expo": {
    "name": "Счётчик ДДД",
    "slug": "schetchik-ddd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zhdi.app",
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#4F5139"
      },
      "package": "com.zhdi.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.0"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Счётчик ДДД использует Face ID, чтобы открыть личный дневник."
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото для фона таймера, дневника и записей встреч.",
          "cameraPermission": "Приложению нужен доступ к камере для фото и видео встреч.",
          "microphonePermission": "Приложению нужен доступ к микрофону для записи видео."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3E3630",
          "defaultChannel": "holidays"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Счётчик ДДД сохраняет картинку таймера в галерею.",
          "savePhotosPermission": "Счётчик ДДД сохраняет картинку таймера в галерею.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TimerWidget",
              "label": "Счётчик ДДД",
              "description": "Дни до дембеля, призыва или конца выбранного срока",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "454fde71-2759-4c33-82cc-342dfba40e0a"
      }
    },
    "owner": "ssklvcva"
  }
}
